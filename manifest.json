{
  "manifest_version": 3,
  "name": "AgentSSNND0",
  "short_name": "SSNND0",
  "version": "0.1.0",
  "description": "Universal AI assistant panel — works with multiple backends",
  "minimum_chrome_version": "116",
  "icons": { "128": "icon.png" },
  "background": {
    "service_worker": "lib/bootstrap.js",
    "type": "module"
  },
  "side_panel": { "default_path": "panel.html" },
  "action": { "default_title": "Open SSNND0" },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "permissions": [
    "sidePanel", "storage", "activeTab", "scripting",
    "tabs", "tabGroups", "alarms", "notifications", "offscreen",
    "unlimitedStorage", "downloads", "debugger"
  ],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [{
    "js": ["lib/inject.js"],
    "matches": ["<all_urls>"],
    "run_at": "document_end"
  }],
  "commands": {
    "toggle-panel": {
      "suggested_key": { "default": "Ctrl+E", "mac": "Command+E" },
      "description": "Toggle SSNND0 panel"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https: http:; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:;"
  },
  "storage": { "managed_schema": "schema.json" }
}
