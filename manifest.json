{
  "manifest_version": 3,
  "name": "AgentSSNND0",
  "short_name": "SSNND0",
  "version": "0.2.0",
  "description": "AI page reader and JEV-driven browser agent for research, browsing, and test-page automation.",
  "minimum_chrome_version": "116",
  "icons": { "128": "icon.png" },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": { "default_path": "panel.html" },
  "action": { "default_title": "Open SSNND0" },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "unlimitedStorage"
  ],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [{
    "js": ["content.js"],
    "matches": ["<all_urls>"],
    "run_at": "document_end"
  }],
  "commands": {
    "toggle-panel": {
      "suggested_key": { "default": "Ctrl+E", "mac": "Command+E" },
      "description": "Toggle SSNND0 panel"
    },
    "toggle-cursor-follow": {
      "suggested_key": { "default": "Alt+Shift+F", "mac": "Option+Shift+F" },
      "description": "Toggle cursor follow mode"
    },
    "toggle-inspect-mode": {
      "suggested_key": { "default": "Alt+Shift+I", "mac": "Option+Shift+I" },
      "description": "Toggle page inspect mode"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https: http:; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:;"
  },
  "storage": { "managed_schema": "schema.json" }
}
